# KaLM-Jev decisions, either on this machine or through an SSH loopback tunnel.
DECISION_PROVIDER=kalm
DECISION_BASE_URL=http://127.0.0.1:8767/v1
DECISION_MODEL=kalm-jev-nano
DECISION_TIMEOUT=120
# Local KaLM needs no key. Never put credentials in a URL.
DECISION_API_KEY=

# TYPE_TEXT alone calls this separate OpenAI-compatible helper.
# Use your own key/model, or a loopback local model with no key.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Original hosted backend (opt-in): set DECISION_PROVIDER=typesafe,
# DECISION_BASE_URL=https://api.typesafe.ai/v1, DECISION_MODEL=jev-latest,
# and put the key in DECISION_API_KEY. No automatic paid fallback occurs.
